# ----------------------------------------------------------------------------
# TDDG Bulletin Agent - example environment file
# ----------------------------------------------------------------------------
# Copy this file to `.env` (no extension on the left of the dot) and fill in
# the values. `.env` is gitignored; this `.env.example` is committed so
# anyone setting up the project knows what variables are required.
# ----------------------------------------------------------------------------

# Anthropic API key. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# User-Agent string sent with every outbound HTTP request.
# Identifies the agent honestly to sites we fetch from. Update the contact
# email so site operators can reach you if there is a problem.
USER_AGENT="TDDG-Bulletin-Agent/0.1 (research; contact@example)"
